# Application Port
PORT=3000

# Environment (development / production)
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/focuslearn
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/focuslearn?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/focuslearn?retryWrites=true&w=majority

# Express Session Secret Key (Change this in production)
SESSION_SECRET=focuslearn_super_secure_session_secret_wad_2026_key
